{
  "name": "@dsh-external/dsh-inspect",
  "description": "A simple find → fix → review loop: checkup (adversarial checking + red-team verification), fix (root cause → fix → verify) and review (adversarial review), built on the official dsh workflow engine. Fork: English prompts and reports, works on dsh 0.1.6–0.2.x, its tools available in every mode.",
  "version": "0.2.0-fork.3",
  "private": true,
  "type": "module",
  "main": "./lib/types/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "src",
    "lib",
    "presets",
    "scripts",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b --pretty false",
    "gen-preset": "node scripts/gen-preset.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.1.6-0 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.6-0 <0.3.0-0",
    "@deepseek-ai/dsh-workflow": ">=0.1.6-0 <0.3.0-0",
    "cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/standard-inspect.patch.yml"
      ]
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/John-UNOwen/dsh-inspect.git"
  }
}
